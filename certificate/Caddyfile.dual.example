# changmen — HTTP 装证引导 + HTTPS mTLS（仅域名，无 IP :443 兜底）
# :80 无客户端证书；正式站：changmen.fun / www（页面+API 同源）+ api（API 双挂）+ ws
# 域名入口：Let's Encrypt；页面站不启用客户端证书，登录/API 由 api 子域强制 mTLS
#   /etc/caddy/certs/le/{fullchain.pem,privkey.pem}
# LE SAN 须含：changmen.fun www.changmen.fun ws.changmen.fun api.changmen.fun
#
# 登录门 B：证书 + 插件。Caddy 须向 Node 注入（或剥离）客户端证头：
#   X-Changmen-Client-Cert / X-Changmen-Client-Subject
# 前端探测 GET /api/client-cert-status
#
# 步骤 1（前后端分开部署）：api.changmen.fun 双挂同一 backend；页面站不变。
# 启用：./sh/step1-enable-api-subdomain.sh（须先 DNS A → VPS）

{
	auto_https off
}

# 无证入口：删掉客户端可伪造的证头
(changmen_proxy_http) {
	reverse_proxy 127.0.0.1:3456 {
		header_up -X-Changmen-Client-Cert
		header_up -X-Changmen-Client-Subject
	}
}

# mTLS 入口：注入证书 subject 供 /api/client-cert-status；无证时为空
(changmen_proxy_mtls) {
	reverse_proxy 127.0.0.1:3456 {
		header_up X-Changmen-Client-Cert {http.request.tls.client.subject}
		header_up X-Changmen-Client-Subject {http.request.tls.client.subject}
	}
}

(changmen_required_mtls_tls) {
	client_auth {
		mode require_and_verify
		trust_pool file /etc/caddy/certs/ca.crt
		verifier leaf {
			folder /etc/caddy/certs/clients
		}
	}
}

# 页面站：静态 + API（现网同源，步骤 1 不改行为）
(changmen_https_site) {
	encode gzip

	root * /root/changmen/client/web/dist

	@health_https path /health /health/pm-market
	handle @health_https {
		import changmen_proxy_mtls
	}
	handle /esport/ws-forward/PM-MARKET* {
		reverse_proxy 127.0.0.1:3457
	}
	handle /esport/ws-forward/PREDICTFUN-MARKET* {
		reverse_proxy 127.0.0.1:3458
	}
	handle /esport/ws-forward/PM-SPORT-MARKET* {
		reverse_proxy 127.0.0.1:3459
	}
	handle /esport/ws-forward/SXBET-MARKET* {
		reverse_proxy 127.0.0.1:3460
	}
	handle /auth/* {
		import changmen_proxy_mtls
	}
	handle /esport/* {
		import changmen_proxy_mtls
	}
	handle /common/* {
		import changmen_proxy_mtls
	}
	handle /api/* {
		import changmen_proxy_mtls
	}
	handle /esport2/* {
		import changmen_proxy_mtls
	}
	@matcher_https path /matcher /matcher/*
	handle @matcher_https {
		import changmen_proxy_mtls
	}
	handle /v4.0/* {
		import changmen_proxy_mtls
	}

	@spa_html_https path / /index.html
	header @spa_html_https Cache-Control "no-cache, no-store, must-revalidate"

	@hashed_assets_https path /assets/*
	header @hashed_assets_https Cache-Control "public, max-age=31536000, immutable"

	handle {
		try_files {path} /index.html
		file_server
	}
}

# API 双挂：仅反代，不托管前端（步骤 1）
(changmen_api_only) {
	encode gzip

	@health_api path /health /health/pm-market
	handle @health_api {
		import changmen_proxy_mtls
	}
	handle /esport/ws-forward/PM-MARKET* {
		reverse_proxy 127.0.0.1:3457
	}
	handle /esport/ws-forward/PREDICTFUN-MARKET* {
		reverse_proxy 127.0.0.1:3458
	}
	handle /esport/ws-forward/PM-SPORT-MARKET* {
		reverse_proxy 127.0.0.1:3459
	}
	handle /esport/ws-forward/SXBET-MARKET* {
		reverse_proxy 127.0.0.1:3460
	}
	handle /auth/* {
		import changmen_proxy_mtls
	}
	handle /esport/* {
		import changmen_proxy_mtls
	}
	handle /common/* {
		import changmen_proxy_mtls
	}
	handle /api/* {
		import changmen_proxy_mtls
	}
	handle /esport2/* {
		import changmen_proxy_mtls
	}
	@matcher_api path /matcher /matcher/*
	handle @matcher_api {
		import changmen_proxy_mtls
	}
	handle /v4.0/* {
		import changmen_proxy_mtls
	}

	handle {
		respond "changmen api" 200
	}
}

:80 {
	encode gzip

	# Let's Encrypt HTTP-01（必须在跳转 HTTPS 之前）
	handle /.well-known/acme-challenge/* {
		root * /var/www/acme
		file_server
	}

	# 证书安装引导（无需客户端证；先下载 ca.crt）
	handle /setup/ca.crt {
		root * /etc/caddy/certs
		rewrite * /ca.crt
		header Content-Type "application/x-x509-ca-cert"
		header Content-Disposition "attachment; filename=\"ca.crt\""
		file_server
	}
	handle /setup {
		redir * /setup/ permanent
	}
	handle_path /setup/* {
		root * /root/changmen/certificate-public
		file_server
	}

	# 拒绝用 IP 走 HTTP（含 /setup）；装证引导只用 http://changmen.fun/setup
	@ip_http host 47.57.10.202
	handle @ip_http {
		respond 403
	}

	# 其余全部跳到 HTTPS（正式站只走域名 mTLS）
	handle {
		redir https://{host}{uri} permanent
	}
}

# 公网域名：Let's Encrypt，浏览器认（页面站 — 步骤 1 不变）
changmen.fun, www.changmen.fun {
	tls /etc/caddy/certs/le/fullchain.pem /etc/caddy/certs/le/privkey.pem
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header Content-Security-Policy "upgrade-insecure-requests"
	import changmen_https_site
}

# API 双挂（步骤 1）：与页面站同一 backend + mTLS；用户仍可只走 changmen.fun
api.changmen.fun {
	tls /etc/caddy/certs/le/fullchain.pem /etc/caddy/certs/le/privkey.pem {
		import changmen_required_mtls_tls
	}
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	import changmen_api_only
}

# 行情 WS 专用：无 mTLS（跨域 WSS 带不上客户端证）
ws.changmen.fun {
	tls /etc/caddy/certs/le/fullchain.pem /etc/caddy/certs/le/privkey.pem
	handle /esport/ws-forward/PM-MARKET* {
		reverse_proxy 127.0.0.1:3457
	}
	handle /esport/ws-forward/PREDICTFUN-MARKET* {
		reverse_proxy 127.0.0.1:3458
	}
	handle /esport/ws-forward/PM-SPORT-MARKET* {
		reverse_proxy 127.0.0.1:3459
	}
	handle /esport/ws-forward/SXBET-MARKET* {
		reverse_proxy 127.0.0.1:3460
	}
}
