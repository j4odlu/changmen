{
  "manifest_version": 3,
  "name": "じらいや",
  "version": "1.3.73",
  "key": "",
  "action": {
    "default_title": "じらいや（侧边栏）",
    "default_icon": {
      "16": "assets/icon.png",
      "48": "assets/icon.png",
      "128": "assets/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "128": "assets/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*.png",
        "assets/*.jpg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://*/*",
      "http://*/*"
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/page-hooks/ray-session.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/page-hooks/ob-sport-merchant-response-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/page-hooks/ob-sport-merchant-capture.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/vendor/socket.io.bundle.js",
        "dist/content.js"
      ],
      "css": [
        "assets/content.css"
      ],
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/pb-ws-content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "*://*.dexsport.io/*",
        "*://*.dexsport.app/*"
      ],
      "js": [
        "src/content/page-hooks/dex-intercept.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/page-hooks/pb-ws-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "*://*.dbgaming.com/*",
        "*://*.dbsporxxxw1box.com/*"
      ],
      "js": [
        "dist/ob-sport-ws-page.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.dbgaming.com/*",
        "*://*.dbsporxxxw1box.com/*"
      ],
      "js": [
        "src/content/page-hooks/ob-sport-ws-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://pinnacleoddsdropper.com/*",
        "*://*.pinnacleoddsdropper.com/*"
      ],
      "js": [
        "src/content/pod-alerts-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://pinnacleoddsdropper.com/*",
        "*://*.pinnacleoddsdropper.com/*"
      ],
      "js": [
        "dist/pod-alerts-page.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*",
    "wss://*/*",
    "ws://*/*"
  ],
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "alarms",
    "activeTab",
    "sidePanel",
    "offscreen"
  ]
}
