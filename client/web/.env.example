# 开发默认走 Vite proxy（相对路径 /esport → VITE_API_PROXY 或本机 backend）
# 本机全栈：不设或指向本机
# VITE_API_PROXY=http://127.0.0.1:3456

# ── remote / VPS（日常改 UI：./sh/dev-esport.sh remote）────────────────
# 只起 Vite，/esport 代理到生产；不起本机 backend（避免双 matcher / 过期 Index）
# VITE_API_PROXY=https://changmen.fun
# 生产 mTLS：Vite 代理须带「你的」客户端证书；CN 必须与登录用户名一致
# VITE_API_PROXY_TLS_CERT=/path/to/certificate/out/clients/你的用户名.crt
# VITE_API_PROXY_TLS_KEY=/path/to/certificate/out/clients/你的用户名.key
# 仅当 API 是自签 HTTPS 时才需要 CA（Let's Encrypt 生产站不要只填自建 CA）
# VITE_API_PROXY_TLS_CA=/path/to/certificate/out/ca.crt
# 写生产请谨慎（SaveData / 试单等）

# Vite 开发端口（默认 Windows 5274 / 其它 5174；Hyper-V 占用 5123-5222 时勿用 5174）
# VITE_DEV_PORT=5274

# 分离部署：前端静态与 API 不同源时设置 API 根（无尾部斜杠）
# 生产默认见 .env.production（VITE_API_BASE=https://api.changmen.fun）
# VITE_API_BASE=https://api.example.com

# 本地 dev 时，http-relay / ws-forward 指向的 HK 服务端（无尾斜杠）
# 注意：设了会把 PM/PF/SX 一并代理到该 host；仅想用线上 Market hub 时不要设，改用下面 VITE_PM_*_HUB_ORIGIN
# VITE_HK_RELAY_ORIGIN=https://你的香港域名或IP
# 仅 DEV：覆盖 Market hub origin。生产忽略，走 GetUserInfo.MarketHubOrigin
# VITE_MARKET_HUB_ORIGIN=https://ws.changmen.fun
# 本地不跑 npm run pm-market-hub 时，把电竞/体育 Market WS 指到线上 hub（推荐）
# VITE_PM_MARKET_HUB_ORIGIN=https://ws.changmen.fun
# VITE_PM_SPORT_MARKET_HUB_ORIGIN=https://ws.changmen.fun

# Predict.fun 主网（测试网：VITE_PREDICT_FUN_API_BASE=https://api-testnet.predict.fun，可省略 Key）
# VITE_PREDICT_FUN_API_BASE=https://api.predict.fun
# VITE_PREDICT_FUN_API_KEY=
# HTTP 出海：direct | vps（默认登录探测；也可 localStorage PF_HTTP_MODE）
# VITE_PF_HTTP_MODE=vps

# 模式 A 运营主号：私钥只放 VPS server/backend/.env（PREDICT_FUN_PRIVY_*），禁止打进前端
# VITE_PREDICT_FUN_PRIVY_PRIVATE_KEY=
# VITE_PREDICT_FUN_PREDICT_ACCOUNT=
# VITE_PREDICT_FUN_MASTER_PRIVATE_KEY=

# 其它已有变量见 docs/CREDIT_PLATE.md（VITE_V4_*、VITE_GAMEBET_EXTENSION_ID）

# DEV 本地联调：跳过扩展门控，Gate 直接出登录框（采集/下注仍要装扩展）
# 默认见 .env.development；覆盖：VITE_SKIP_EXTENSION_GATE=0 恢复强制检测
# VITE_SKIP_EXTENSION_GATE=1

# 可选：浏览器侧 Polygon RPC（PM 推导 Deposit Wallet；不设则用公共节点 fallback）
# VITE_POLYGON_RPC_URL=https://polygon-bor.publicnode.com

# Unified native Cookie login; enable only after backend compatibility acceptance.
# VITE_WEB_COOKIE_AUTH=1
