  "valueParsing": {
    "asianHandicap": {
      "evidence": "official_source",
      "sourceFunctions": [
        "parseAhdpValue",
        "Mn"
      ],
      "tag": "ahdp",
      "delimiter": ",",
      "scorePrefixPattern": "^\\d+-\\d+$",
      "resultFields": [
        "score",
        "line"
      ],
      "recognizedPrefix": {
        "score": "trim(first segment)",
        "line": "trim(join(remaining segments, comma))"
      },
      "unrecognizedPrefix": {
        "score": "",
        "line": "trim(original value)"
      },
      "numericSorting": {
        "scoreLeft": "parseFloat(first score component)",
        "scoreRight": "parseFloat(second score component)",
        "line": "parseFloat(line)"
      },
      "examples": [
        {
          "input": "0-0,+0.25",
          "output": {
            "score": "0-0",
            "line": "+0.25"
          }
        },
        {
          "input": "2-1,-0.75",
          "output": {
            "score": "2-1",
            "line": "-0.75"
          }
        },
        {
          "input": "+1.5",
          "output": {
            "score": "",
            "line": "+1.5"
          }
        }
      ],
      "notes": [
        "保留原始 value；score 是官网给前缀使用的字段名。",
        "score 必须参与该类盘口的分组；不能只保留逗号后的分数线。",
        "此解析不等于已经确认滚球基准比分或该盘的完整结算方式。"
      ]
    },
    "overUnder": {
      "evidence": "official_source",
      "tag": "ou",
      "rawComparatorSymbols": [
        ">",
        "<"
      ],
      "displayReplacements": {
        ">": "over ",
        "<": "under "
      },
      "preserveRawThreshold": true
    },
    "quarterLineDisplay": {
      "evidence": "official_source",
      "sourceModule": "9160",
      "enabledTags": [
        "ahdp",
        "ou"
      ],
      "fractionalParts": [
        0.25,
        0.75
      ],
      "numericTolerance": 1e-8,
      "preserveExplicitSign": true,
      "displayRule": "绝对值落在 .25 或 .75 时，显示为两条相邻半分线；两项分别保留原符号。",
      "examples": [
        {
          "input": "+0.25",
          "output": "+0, +0.5"
        },
        {
          "input": "-0.75",
          "output": "-0.5, -1"
        },
        {
          "input": "3.25",
          "output": "3, 3.5"
        }
      ],
      "notes": [
        "这里记录官网的显示格式转换，不据此声明分注比例、退款或半赢半输结算规则。",
        "该显示分支允许的 tag 是 ahdp、ou，不能擅自扩展成所有 hdp。"
      ]
    }
  },
  "displaySorting": {
    "evidence": "official_source",
