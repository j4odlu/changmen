{
  "name": "changmen",
  "private": true,
  "description": "A8 esports aggregator — frontend replica + local backend",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/arb-core",
    "packages/shared",
    "packages/client-core",
    "packages/api-contract",
    "client/web",
    "chrome-extension",
    "packages/venue-adapter",
    "server/backend",
    "server/match/*",
    "server/db",
    "server/storage",
    "server/ws_forward",
    "server/realtime-hub",
    "devtools/platform-probes",
    "server/value-bet",
    "server/collectors/polymarket-sports",
    "server/collectors/polymarket-esports",
    "server/collectors/polymarket-football",
    "server/collectors/predictfun-collector",
    "server/collectors/sxbet-collector"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "turbo run dev",
    "dev:remote": "bash sh/dev-esport.sh remote",
    "dev:backend": "turbo run dev --filter=@changmen/backend",
    "esport:dev": "npm run web --prefix server/backend",
    "dev:frontend": "turbo run dev --filter=@changmen/web",
    "web": "npm run web --prefix server/backend",
    "web:restart": "npm run web:restart --prefix server/backend",
    "app:dev": "npm run dev --prefix client/web",
    "app:build": "turbo run build --filter=@changmen/web --force",
    "check:boundaries": "node scripts/check-team-boundaries.mjs",
    "check:fok-parity": "node scripts/verification/verify-fok-execution-parity.mjs && node scripts/verification/verify-gtc-module-isolation.mjs",
    "check:fok-vps": "node scripts/verification/verify-vps-fok-baseline.mjs",
    "check:fok-release": "node scripts/verification/verify-fok-release.mjs",
    "check:venue-adapter": "npm run check:exports --workspace=@changmen/venue-adapter && npm run check:internal-imports --workspace=@changmen/venue-adapter && npm run check:web-imports --workspace=@changmen/venue-adapter && npm run check:esport-freeze --workspace=@changmen/venue-adapter",
    "check:client-core": "npm run check:exports --workspace=@changmen/client-core && npm run check:internal-imports --workspace=@changmen/client-core && npm run check:consumer-imports --workspace=@changmen/client-core",
    "test:api-contract": "node packages/api-contract/urls.test.mjs",
    "test:checks": "npm run check:boundaries && npm run check:venue-adapter && npm run check:client-core && npm run test:api-contract && npm run test:catalog-smoke",
    "test": "npm run test:checks && turbo run test",
    "test:backend": "npm run test:checks && turbo run test --filter=./server/**...",
    "typecheck:frontend": "turbo run typecheck --filter=@changmen/web",
    "analyze:deps": "npm run analyze:deps:check --prefix client/web",
    "test:frontend": "turbo run typecheck test --filter=@changmen/web",
    "test:catalog-smoke": "node scripts/catalog-smoke.mjs",
    "sync:market-indexes": "node scripts/sync/pull-vps-market-indexes.mjs",
    "matcher:ui": "npm run start --prefix server/match/matcher",
    "composer:once": "npm run compose:once --prefix server/match/matcher",
    "composer:diff": "npm run compose:diff --prefix server/match/matcher",
    "composer:start": "npm run compose --prefix server/match/matcher",
    "composer:ui": "npm run ui:compare --prefix server/match/matcher",
    "composer:test": "turbo run test --filter=@changmen/matcher...",
    "audit:client-sources": "node server/match/matcher/scripts/audit-client-sources.mjs",
    "check:index-drift": "node .ai/architecture/build-index.mjs --check",
    "check:index-acceptance": "node .ai/architecture/acceptance-cases.mjs",
    "check:index-completeness": "node .ai/architecture/check-truth-completeness.mjs",
    "pm-sports": "npm run start --prefix server/collectors/polymarket-sports",
    "polymarket-collector": "npm run start --prefix server/collectors/polymarket-esports",
    "pm-football-collector": "npm run start --prefix server/collectors/polymarket-football",
    "pm-market-hub": "node server/ws_forward/pm_market_hub_server.js",
    "pm-sport-market-hub": "node server/ws_forward/pm_sport_market_hub_server.js",
    "predictfun-market-hub": "node server/ws_forward/predictfun_market_hub_server.js",
    "sxbet-market-hub": "node server/ws_forward/sxbet_market_hub_server.js",
    "predictfun-collector": "npm run start --prefix server/collectors/predictfun-collector",
    "sxbet-collector": "npm run start --prefix server/collectors/sxbet-collector",
    "chromeplug:pack": "npm run pack --workspace=@changmen/chrome-extension",
    "ob:lock-observe": "npm run ob:lock-observe --workspace=@changmen/venue-adapter",
    "value-bet": "npm run start --prefix server/value-bet",
    "value-bet:scan": "npm run scan:once --prefix server/value-bet",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "eslint": "^10.5.0",
    "turbo": "^2.11.7"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
