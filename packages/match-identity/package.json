{
  "name": "@changmen/match-identity",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "赛事与队伍身份领域规则，供 matcher、resolver 和 RDS 使用",
  "exports": {
    ".": "./index.ts",
    "./ids/*.js": "./ids/*.ts",
    "./teams/*.js": "./teams/*.ts",
    "./teams/team_aliases.json": "./teams/team_aliases.json",
