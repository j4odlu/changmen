# canonical：server/backend/.env（matcher 与运维脚本默认读本文件）
# 复制：BAT\setup-dev-env.bat  或  copy .env.example .env

# ── 必填（本地联调 / 登录）────────────────────────────
JWT_SECRET=change-me-use-at-least-32-random-bytes
# Unified Web Cookie session rollout: enable only after compatibility acceptance.
WEB_AUTH_COOKIE_ENABLED=0
WEB_AUTH_CSRF_SECRET=
# WEB_AUTH_ORIGINS=https://changmen.fun,https://www.changmen.fun,https://api.changmen.fun
JWT_ACCESS_TTL=15m
JWT_BROWSER_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=changmen-auth
JWT_AUDIENCE=changmen-api
AUTH_MODE=dual
CHANGMEN_DB_SCRIPT=rds

# RDS（内网+外网可同时写；默认 auto：VPS 走 INTERNAL，本机走 PUBLIC）
# DATABASE_URL=postgresql://user:pass@host:5432/gamebet
# DATABASE_URL_PUBLIC=postgresql://user:pass@pgm-xxxho.pg.rds.aliyuncs.com:5432/gamebet
# DATABASE_URL_INTERNAL=postgresql://user:pass@pgm-xxx.pg.rds.aliyuncs.com:5432/gamebet
# DATABASE_RDS_TARGET=auto
# VPS 勿设 public；本机开发可 auto（内网不通则回退 public）或显式 public
# DATABASE_SSL=1
# DATABASE_POOL_MAX=12
# DATABASE_POOL_CONNECT_TIMEOUT_MS=10000
# DATABASE_STATEMENT_TIMEOUT_MS=30000
# DATABASE_QUERY_TIMEOUT_MS=35000
# DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
# DATABASE_POOL_IDLE_TIMEOUT_MS=30000
# DATABASE_POOL_MAX_LIFETIME_SEC=600
# RDS 异步写队列（_writeRds）：同 key coalesce 保最新；满且无法 coalesce 仍 drop（见 docs/DATA_STORAGE.md）
# RDS_WRITE_QUEUE_MAX=2000
# RDS_WRITE_CONCURRENCY=3
# WS_FORWARD_PLATFORMS=IA,OB,RAY,PREDICTFUN-MARKET
# 说明：PM-MARKET / PM-SPORT-MARKET 由独立进程承担（:3457 / :3459），勿列入本列表（否则会拖死 esport）
# 若进程假死/登录超时，可先去掉 PM-USER（1:1 raw 易灌死事件循环）
# PM_MARKET_HUB_PORT=3457
# PM_SPORT_MARKET_HUB_PORT=3459
# Market hub 分流（无 market_hub_route.json 时生效；改名单优先走管理页）
# 默认全员 202；单一 hub，不再配置 secondary
# MARKET_HUB_PRIMARY_USERS=gb11,gb12,gb13,gb14,gb15
# MARKET_HUB_PRIMARY_ORIGIN=https://ws.changmen.fun
# 系统健康汇聚 202 hub（默认由 MARKET_HUB_PRIMARY_ORIGIN 拼出 /health/pm-market；0=关）
# MARKET_HUB_PRIMARY_HEALTH_URL=https://ws.changmen.fun/health/pm-market
# WS_FORWARD_MAX_BUFFERED_BYTES=524288
# WS_FORWARD_SLOW_CONSUMER_MS=5000
# PORT=3700
# 生产 mTLS 登录绑定（叶子 CN=用户名）；本机开发默认关。显式：CHANGMEN_CERT_LOGIN_BIND=0/1
# CHANGMEN_CERT_LOGIN_BIND=0
# matchMerge 内嵌在 changmen-esport（npm run web 启动时自动跑 30s 循环）
# 步骤 2：页面站 → API 子域 CORS（默认 https://changmen.fun,https://www.changmen.fun）
# CORS_ALLOWED_ORIGINS=https://changmen.fun,https://www.changmen.fun,http://localhost:5174
# MATCHER_INTERVAL_MS=30000
# MATCHER_CLIENT_MATCH_ARCHIVE_INTERVAL_MS=3600000
# MATCHER_PRUNE_INTERVAL_MS=3600000  # 旧名，仍兼容
# COLLECTOR_HOT_CACHE_TTL_MS=180000
# MATCHER_UI_PORT=4567
# MATCHER_SKIP_AUTH=1
# 合场唯一写路径：esport 内嵌 @changmen/matcher 的 compose/
# COMPOSER_UI_PORT=4568
# 配对 / 真相表 / 发布策略等业务行为见 changmen/server/match/matcher/lib/config.js（勿用 env 开关）
# PB 同 rotNum 多 event 认一场（默认开；回滚 COMPOSER_PB_ROTNUM_COLLAPSE=0）
# COMPOSER_PB_ROTNUM_COLLAPSE=0
# HTTP_RELAY_REQUIRE_TOKEN=1
# HTTP_RELAY_ALLOWED_HOSTS=gamma-api.polymarket.com,clob.polymarket.com,api.predict.fun,api-testnet.predict.fun
# HTTP_RELAY_ALLOWED_PATH_PREFIXES=/
# HTTP_RELAY_ALLOW_PRIVATE=0
# 可选：probe-hk-relay / 部署探针 JWT（HTTP_RELAY_REQUIRE_TOKEN=1 时在 VPS .env 与 GitHub secret PROBE_TOKEN 各设一份）
# PROBE_TOKEN=
# Predict.fun 主网 WS 中继（ws-forward/PREDICTFUN-MARKET；测试网可省略）
# PREDICT_FUN_WS_URL=wss://ws.predict.fun/ws
# 跳过主号 setApprovals（仅测试）：PF_HOUSE_SKIP_APPROVALS=1
# 跳过 predictWalletEvents：PF_HOUSE_SKIP_WALLET_EVENTS=1
# PREDICT_FUN_API_KEY=
# PREDICT_FUN_API_BASE=https://api.predict.fun
# SX.bet Centrifugo hub（changmen-sxbet-market-hub；一把 key，勿下发浏览器）
# SXBET_API_KEY=
# SXBET_MARKET_HUB_PORT=3460
# House 代下（B 号；私钥仅 VPS，禁止打进前端 VITE_*）
# PREDICT_FUN_PRIVY_PRIVATE_KEY=
# PREDICT_FUN_PREDICT_ACCOUNT=0x...
# PF_HOUSE_MAX_STAKE_USDT=500
# changmen PF 自有费率（bps；管理端「PF 会员」页可改，落盘后优先生效）
# PF_CHANGMEN_BUY_FEE_RATE_BPS=0
# PF_CHANGMEN_SELL_FEE_RATE_BPS=0
# 兼容旧单项（仅卖出默认）：PF_CHANGMEN_FEE_RATE_BPS=0
# TELEGRAM_BOT_TOKEN=
# 服务端管理员 Telegram（core/admin_tools；与客户端用户各自填 telegramId 独立）
# TELEGRAM_ADMIN_CHAT_ID=
# TELEGRAM_ADMIN_NOTIFY=1
# RDS 新订单一行一推（默认关；下单提醒不再抄送管理员）
# TELEGRAM_ORDER_NOTIFY=0
# TELEGRAM_ORDER_NOTIFY_MAX_AGE_MIN=120

# ── Polymarket Relayer（Plan A：密钥放服务端，客户端私钥签名）──
# changmen 多用户：用 Builder API Keys 三组（Settings > Builder > API Keys，DEV_CONFIG 同组）
# Builder 代任意用户钱包付 gas；每笔 Relayer 请求服务端算 HMAC。
# POLY_BUILDER_API_KEY=
# POLY_BUILDER_SECRET=
# POLY_BUILDER_PASSPHRASE=
# POLYMARKET_RELAYER_URL=https://relayer-v2.polymarket.com
# RPC_URL=https://polygon-bor.publicnode.com
# POLYGON_RPC_URL=https://polygon-bor.publicnode.com
# POLYMARKET_POLYGON_RPC=https://polygon-bor.publicnode.com
#
# 单地址自用：Relayer API Key（2 项）。RELAYER_API_KEY_ADDRESS 必须 = 账号私钥对应地址。
# RELAYER_API_KEY=
# RELAYER_API_KEY_ADDRESS=0x...
# POLYMARKET_RELAYER_AUTH=relayer_api_key   # 强制用 Relayer Key（与 POLY_BUILDER_* 二选一）

# Local dev: backend on port 3700 reads RDS and auto-syncs VPS MarketIndex JSON.
# Set 0/off to disable when debugging with a manually synced storage directory.
# CHANGMEN_VPS_MARKET_INDEX_SYNC=1
# MARKET_INDEX_SYNC_INTERVAL_SEC=60

# 管理员：users.is_admin — node scripts/create-user.js --admin <用户> <密码>

