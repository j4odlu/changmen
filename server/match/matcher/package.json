{
  "name": "@changmen/matcher",
  "type": "module",
  "version": "1.0.0",
  "description": "赛事匹配运行时 — 合场算法（compose/）、调度循环、人工关联 Web 面板",
  "exports": {
    ".": "./index.js",
    "./loop.js": "./loop.js",
    "./runtime_ports.js": "./runtime_ports.js",
    "./ray_match_risk.js": "./ray_match_risk.js",
    "./ui/matcher_auth.js": "./ui/matcher_auth.js",
    "./ui/server.js": "./ui/server.js",
    "./lib/config.js": "./lib/config.js",
    "./lib/heartbeat.js": "./lib/heartbeat.js",
    "./link/index.js": "./link/index.js",
    "./ops/match_merge_once.js": "./ops/match_merge_once.js",
    "./ops/rds_snapshot_cache.js": "./ops/rds_snapshot_cache.js",
    "./compose/compose_once.js": "./compose/compose_once.js",
    "./compose/normalize/native_bets.js": "./compose/normalize/native_bets.js",
    "./compose/util/swap": "./compose/util/swap.ts",
    "./ui/http_bridge.js": "./ui/http_bridge.js",
    "./ui/public": "./ui/public/index.html",
    "./package.json": "./package.json"
  },
  "main": "./index.js",
  "scripts": {
    "start": "node ../../backend/scripts/matcher-ui.mjs",
    "ui:compare": "node ui/compare/server.js",
    "compose": "node compose/loop.js",
    "compose:once": "node scripts/once.mjs",
    "compose:diff": "node scripts/diff.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run typecheck && node scripts/check-no-merge-import.mjs && vitest run --no-file-parallelism && node --test tests/compose-helpers.node.mjs",
    "test:with-deps": "npm run test --workspace=@changmen/match-identity && npm test",
    "check:no-merge-import": "node scripts/check-no-merge-import.mjs"
  },
  "dependencies": {
    "@changmen/db": "file:../../../rds",
    "@changmen/shared": "file:../../../packages/shared",
    "@changmen/storage": "file:../../storage",
    "@changmen/team-resolver": "file:../resolver",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "@changmen/match-identity": "file:../../../packages/match-identity"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "^25.9.1",
    "vitest": "^4.1.8"
  }
}
