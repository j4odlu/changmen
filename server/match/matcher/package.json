{
  "name": "@changmen/matcher",
  "type": "module",
  "version": "1.0.0",
  "description": "赛事匹配运行时 — 合场算法（compose/）、调度循环、人工关联 Web 面板",
  "exports": {
    ".": "./index.js",
    "./loop.js": "./loop.js",
    "./lib/heartbeat.js": "./lib/heartbeat.js",
    "./link/index.js": "./link/index.js",
    "./ops/match_merge_once.js": "./ops/match_merge_once.js",
    "./ops/rds_snapshot_cache.js": "./ops/rds_snapshot_cache.js",
    "./compose/compose_once.js": "./compose/compose_once.js",
    "./compose/normalize/native_bets.js": "./compose/normalize/native_bets.js",
    "./compose/util/swap.js": "./compose/util/swap.js",
    "./ui/http_bridge.js": "./ui/http_bridge.js",
    "./ui/public": "./ui/public/index.html",
    "./package.json": "./package.json"
  },
  "main": "./index.js",
  "scripts": {
    "start": "node ui/server.js",
    "ui:compare": "node ui/compare/server.js",
    "compose": "node compose/loop.js",
    "compose:once": "node scripts/once.mjs",
    "compose:diff": "node scripts/diff.mjs",
    "test": "node scripts/check-no-merge-import.mjs && vitest run --no-file-parallelism",
    "test:with-deps": "npm run test --prefix ../identity && npm test",
    "check:no-merge-import": "node scripts/check-no-merge-import.mjs"
  },
  "dependencies": {
    "@changmen/db": "file:../../db",
    "@changmen/match-identity": "file:../identity",
    "@changmen/shared": "file:../../../packages/shared",
    "@changmen/storage": "file:../../storage",
    "@changmen/team-resolver": "file:../resolver",
    "dotenv": "^16.0.0",
    "express": "^4.18.0"
  }
}
