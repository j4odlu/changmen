{
  "name": "@changmen/team-resolver",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone esports team name resolver — maps platform-specific team names to canonical IDs via PandaScore / local cache",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./team_db.js": "./team_db.js",
    "./sport_team_plugin.js": "./sport_team_plugin.js"
  },
  "scripts": {
    "test": "vitest run resolver.offline.test.mjs && node --test sport_team_plugin.smoke.test.mjs",
    "probe:live": "node test.js",
    "seed": "node seed.js",
    "scrape:ray": "node scrapers/ray_scraper.js",
    "scrape:ray:dry": "node scrapers/ray_scraper.js --dry-run",
    "scrape:ob": "node scrapers/ob_scraper.js",
    "scrape:ob:dry": "node scrapers/ob_scraper.js --dry-run",
    "scrape:pb": "node scrapers/pb_scraper.mjs",
    "scrape:pb:dry": "node scrapers/pb_scraper.mjs --dry-run"
  },
  "dependencies": {
    "@changmen/db": "file:../../../rds",
    "@changmen/storage": "file:../../storage",
    "@changmen/shared": "file:../../../packages/shared",
    "axios": "^1.7.2",
    "@changmen/match-identity": "file:../../../packages/match-identity"
  },
  "devDependencies": {
    "@changmen/venue-node": "file:../../venues"
  }
}
