{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@changmen/web#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/client/listener/module/**", "$TURBO_ROOT$/client/listener/build/*", "$TURBO_ROOT$/client/listener/tests/**"],
      "outputs": ["dist/**"]
    },
    "@changmen/web#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/testing/offline-env.mjs", "$TURBO_ROOT$/client/listener/module/**", "$TURBO_ROOT$/client/listener/build/*", "$TURBO_ROOT$/client/listener/tests/**", "!**/*.md", "!**/docs/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/testing/offline-env.mjs", "!**/*.md", "!**/docs/**"]
    },
    "@changmen/matcher#test": {
      "dependsOn": ["^test", "^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/docs/**"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/docs/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/docs/**"]
    }
  }
}
